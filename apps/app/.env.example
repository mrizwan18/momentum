# Push notifications (see IMPLEMENT.md's "Scope Exception: Push Notifications")
#
# VAPID keypair — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is not secret; the private key must never be committed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY, exposed to the browser (subscribe() needs it client-side).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Protects /api/push/send-daily from being called by anyone but Vercel Cron.
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on cron-triggered
# requests once this is set — generate any long random string.
CRON_SECRET=

# Optional: without these, subscriptions are stored in memory and lost on every
# serverless cold start. Attach a Redis integration (Vercel Marketplace) to get these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
