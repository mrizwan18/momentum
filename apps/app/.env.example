# Push notifications (see IMPLEMENT.md's "Scope Exception: Push Notifications")
#
# VAPID keypair — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is not secret; the private key must never be committed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Same value as VAPID_PUBLIC_KEY, exposed to the browser (subscribe() needs it client-side).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Protects /api/push/send-daily from being called by anyone but Vercel Cron.
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on cron-triggered
# requests once this is set — generate any long random string.
CRON_SECRET=

# Optional: without these, subscriptions are stored in memory and lost on every
# serverless cold start. Attach a Redis integration (Vercel Marketplace) to get these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI Intelligence Layer (see IMPLEMENT.md's "Scope Exception: AI Intelligence Layer")
#
# Which provider the Gateway uses. Defaults to "mock" (deterministic, offline,
# zero network) when unset or invalid — real providers require the matching
# key/URL below to actually be configured.
AI_PROVIDER=mock
# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Audio-input-capable model, used only when a real recording is attached
# (Baseline assessment, and opt-in Session Summary analysis).
OPENAI_AUDIO_MODEL=gpt-4o-audio-preview
# gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# ollama (self-hosted — a reachable base URL, no API key)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
# AI response cache reuses the same Redis config as push notifications above —
# no separate variables needed.
